# Chatwoot Stage env for EasyPanel
# Copy and paste this into the EasyPanel Environment editor
#
# IMPORTANT:
# If this stage app has an old postgres volume, these vars will NOT recreate the DB user.
# In that case, delete the postgres volume/service data in EasyPanel and deploy again.

# Required - change these 3 first
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
SECRET_KEY_BASE=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET_KEY
FRONTEND_URL=https://clientes-tools-chatwoot-stage.am5xdk.easypanel.host

# Postgres
POSTGRES_DB=chatwoot_stage
POSTGRES_USER=postgres

# App
RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker
FORCE_SSL=false
TRUSTED_PROXIES=*
RAILS_LOG_TO_STDOUT=true
RAILS_SERVE_STATIC_FILES=true
ENABLE_ACCOUNT_SIGNUP=false
DEFAULT_LOCALE=pt-BR
FEATURE_CRM_ENABLED=true
ACTIVE_STORAGE_SERVICE=local

# Mailer
MAILER_SENDER_EMAIL="Chatwoot Stage <no-reply@your-domain.com>"
# SMTP_ADDRESS=smtp.resend.com
# SMTP_PORT=587
# SMTP_USERNAME=resend
# SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
# SMTP_AUTHENTICATION=plain
# SMTP_ENABLE_STARTTLS_AUTO=true
# SMTP_OPENSSL_VERIFY_MODE=none

# Optional
TZ=America/Sao_Paulo
LOG_LEVEL=info
