{
  "type": "object",
  "required": [
    "postgresPassword",
    "secretKeyBase",
    "frontendUrl"
  ],
  "properties": {
    "postgresPassword": {
      "type": "string",
      "title": "Senha do PostgreSQL",
      "generator": "password",
      "description": "Gerada automaticamente pelo EasyPanel"
    },
    "secretKeyBase": {
      "type": "string",
      "title": "SECRET_KEY_BASE",
      "generator": "secret",
      "description": "Chave de 64 caracteres gerada automaticamente"
    },
    "frontendUrl": {
      "type": "string",
      "title": "URL Frontend (Stage/Prod)",
      "default": "https://clientes-tools-chatwoot-stage.am5xdk.easypanel.host",
      "description": "URL principal de acesso ao Chatwoot"
    },
    "postgresDatabase": {
      "type": "string",
      "title": "Nome do Banco de Dados",
      "default": "chatwoot_production"
    },
    "postgresUser": {
      "type": "string",
      "title": "Usuário do Banco",
      "default": "chatwoot_prod"
    },
    "openaiApiKey": {
      "type": "string",
      "title": "OpenAI API Key",
      "default": "sk-proj-YOUR_KEY_HERE"
    },
    "anthropicApiKey": {
      "type": "string",
      "title": "Anthropic API Key",
      "default": "sk-ant-api03-YOUR_KEY_HERE"
    },
    "geminiApiKey": {
      "type": "string",
      "title": "Gemini API Key",
      "default": "AIzaSyYOUR_KEY_HERE"
    }
  }
}
